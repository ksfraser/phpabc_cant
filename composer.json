{
  "name": "ksfraser/phpabc_canntaireachd",
  "description": "ABC notation and canntaireachd tools for PHP.",
  "type": "library",
  "license": "MIT",
  "authors": [
    {
      "name": "ksfraser"
    }
  ],
  "repositories": [],
  "autoload": {
    "psr-4": {
      "ksfraser\\PhpabcCanntaireachd\\": "src/ksfraser/PhpabcCanntaireachd/",
      "ksfraser\\origin\\": "src/ksfraser/origin/"
    }
  },
  "require": {
    "php": "^8.1",
    "symfony/yaml": "^6.4 || ^7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "config": {
    "allow-plugins": {
      "symfony/flex": true
    },
    "platform": {
      "php": "8.1.18"
    },
    "sort-packages": true
  }
}
